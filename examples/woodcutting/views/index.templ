package views

import "github.com/justintout/go-osrs/woodcutting"
import "github.com/justintout/go-osrs/hiscores"
import "fmt"

templ Index(trees []woodcutting.Tree, actions []woodcutting.Action, player *hiscores.Player) {
	@layout("Woodcutting Calculator") {
		<h1>Woodcutting Calculator</h1>

		<form hx-get="/lookup" hx-target="#lookup-results" hx-swap="innerHTML">
			<label for="username">Username:</label>
			<input type="text" id="username" name="username"/>
			<button type="submit">Lookup</button>
		</form>
		<div id="lookup-results">
			if player != nil {
				@PlayerInfo(player)
			}
		</div>

		<form hx-get="/calculate" hx-target="#results" hx-swap="innerHTML">
			<label for="startLevel">Start Level:</label>
			<input type="number" id="startLevel" name="startLevel" value="1"/>
			<label for="targetLevel">Target Level:</label>
			<input type="number" id="targetLevel" name="targetLevel" value="99"/>

			<h2>Tree Settings</h2>
			<table>
				<thead>
					<tr>
						<th>Tree</th>
						<th>Disable</th>
						<th>Override Start Level</th>
					</tr>
				</thead>
				<tbody>
					for _, tree := range trees {
						<tr>
							<td>{ tree.Name }</td>
							<td><input type="checkbox" id={ tree.Name } name="disabledTrees" value={ tree.Name }/></td>
							<td><input type="number" name={ "override_" + tree.Name } placeholder={ fmt.Sprintf("%d", tree.Level) } /></td>
						</tr>
					}
				</tbody>
			</table>

			<button type="submit">Calculate</button>
		</form>
		<div id="results">
			if actions != nil {
				@Results(actions)
			}
		</div>
	}
}

// PlayerInfo shows a player's Woodcutting level and, through an htmx
// out-of-band swap, sets the start level field to it.
templ PlayerInfo(player *hiscores.Player) {
	if woodcuttingSkill, ok := player.Skill("Woodcutting"); ok {
		<p>
			{ player.Name }: Woodcutting level { fmt.Sprintf("%d", max(woodcuttingSkill.Level, 1)) }, { fmt.Sprintf("%d", max(woodcuttingSkill.XP, 0)) } XP
		</p>
		<input type="number" id="startLevel" name="startLevel" value={ fmt.Sprintf("%d", max(woodcuttingSkill.Level, 1)) } hx-swap-oob="true"/>
	}
}