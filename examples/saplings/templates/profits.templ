package templates

import (
	"strconv"
	"strings"
)

// Row is one seed and the sapling it grows into.
type Row struct {
	Tree           string
	SeedPrice      int
	SaplingPrice   int
	Profit         int
	ProfitPerLimit int
	SeedLimit      int
	SaplingVolume  int
	SeedImage      string
	SaplingImage   string
	// Priced is false when either item has no recent trade.
	Priced bool
}

// gp formats coins with thousands separators.
func gp(n int) string {
	s := strconv.Itoa(n)
	neg := strings.HasPrefix(s, "-")
	s = strings.TrimPrefix(s, "-")
	var b strings.Builder
	for i, r := range s {
		if i > 0 && (len(s)-i)%3 == 0 {
			b.WriteByte(',')
		}
		b.WriteRune(r)
	}
	if neg {
		return "-" + b.String()
	}
	return b.String()
}

func profitClass(p int) string {
	switch {
	case p < 0:
		return "loss"
	case p < 500:
		return "thin"
	}
	return "good"
}

templ Profits(rows []Row) {
	<table>
		<thead>
			<tr>
				<th>Tree</th>
				<th>Seed (buy)</th>
				<th>Sapling (sell)</th>
				<th>Profit each, after tax</th>
				<th>Profit per 4h seed limit</th>
				<th>Sapling 24h volume</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr>
					<td>{ r.Tree }</td>
					<td><img src={ r.SeedImage } alt=""/> { gp(r.SeedPrice) }</td>
					<td><img src={ r.SaplingImage } alt=""/> { gp(r.SaplingPrice) }</td>
					if r.Priced {
						<td class={ profitClass(r.Profit) }>{ gp(r.Profit) }</td>
						<td class={ profitClass(r.Profit) }>{ gp(r.ProfitPerLimit) } <small>({ strconv.Itoa(r.SeedLimit) } seeds)</small></td>
					} else {
						<td colspan="2" class="thin">no recent trades</td>
					}
					<td>{ gp(r.SaplingVolume) }</td>
				</tr>
			}
		</tbody>
	</table>
}
